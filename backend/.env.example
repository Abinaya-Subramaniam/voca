# Local dev uses SQLite; for production point at managed Postgres, e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/voca
DATABASE_URL=sqlite:///./voca.db

# Generate a long random string for production
JWT_SECRET=change-me-in-production

OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Used as an automatic fallback if OpenAI errors out (rate limit, outage, etc)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
